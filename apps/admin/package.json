{
  "name": "@cms0/admin",
  "version": "0.0.1",
  "private": true,
  "files": [
    "app",
    "components",
    "db",
    "lib",
    "public",
    "components.json",
    "drizzle.config.ts",
    "instrumentation.ts",
    "next-env.d.ts",
    "next.config.ts",
    "postcss.config.mjs",
    "proxy.ts",
    "tsconfig.json"
  ],
  "scripts": {
    "dev": "dotenv -e .env.local -- next dev --webpack -p \"${PORT:-3000}\"",
    "dev:e2e": "NODE_OPTIONS=--max-old-space-size=12288 __NEXT_DISABLE_MEMORY_WATCHER=1 dotenv -e .env.e2e -- next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "pnpm test:unit && pnpm test:integration",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:unit": "pnpm -C ../.. exec vitest run --config vitest.config.ts --project admin-unit",
    "test:integration": "pnpm -C ../.. exec vitest run --config vitest.config.ts --project admin-integration"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.9",
    "@cms0/admin-client": "workspace:*",
    "@cms0/admin-contract": "workspace:*",
    "@cms0/api-docs": "workspace:*",
    "@cms0/admin-server": "workspace:*",
    "@cms0/auth": "workspace:*",
    "@cms0/db-schema-ops": "workspace:*",
    "@cms0/shared": "workspace:*",
    "@cms0/transactional": "workspace:*",
    "@cms0/ui": "workspace:*",
    "@tanstack/react-form": "^1.27.0",
    "@tanstack/react-query": "^5.90.11",
    "better-auth": "^1.6.9",
    "dotenv-cli": "^7.4.4",
    "drizzle-orm": "^0.44.7",
    "lucide-react": "^0.555.0",
    "next": "16.2.2",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "license": "AGPL-3.0-or-later"
}
