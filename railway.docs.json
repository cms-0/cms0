{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm build:docs",
    "watchPatterns": [
      "/apps/docs/**",
      "/packages/typescript-config/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/turbo.json",
      "/railway.docs.json"
    ]
  },
  "deploy": {
    "startCommand": "cd apps/docs && pnpm exec serve out --listen tcp://0.0.0.0:${PORT:-3008}",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
