PORT=3008
ENVIRONMENT=local

# Canonical hosted cms0 app URL used for path-based environment runtime examples.
CMS0_PUBLIC_APP_URL=http://localhost:3001

# Base domain used for subdomain-based environment runtime examples.
CMS0_BASE_DOMAIN=localhost:3001
CMS0_PUBLIC_ENV_PATH_RUNTIME_ENABLED=1
CMS0_PUBLIC_ENV_SUBDOMAIN_RUNTIME_ENABLED=1

# Optional docs app URL. If unset, local docs use http://localhost:${PORT}.
CMS0_DOCS_PUBLIC_URL=http://localhost:3008

# Optional Nextra chrome links.
DOCS_REPOSITORY_BASE=
PROJECT_REPOSITORY_LINK=
