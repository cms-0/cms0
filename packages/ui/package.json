{
  "name": "@cms0/ui",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "types": "./src/components/*.tsx",
      "default": "./dist/components/*.js"
    },
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "default": "./dist/hooks/*.js"
    },
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "default": "./dist/lib/*.js"
    },
    "./styles/*": {
      "style": "./src/styles/*.css",
      "default": "./src/styles/*.css"
    }
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "pnpm run build:clean && tsc -p tsconfig.json",
    "build:clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true });\"",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:unit": "pnpm -C ../.. exec vitest run --config vitest.config.ts --project ui-unit",
    "test": "pnpm test:unit"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@cms0/admin-client": "workspace:*",
    "@cms0/admin-contract": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-form": "^1.27.0",
    "@tanstack/react-query": "^5.90.11",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/core": "^3.19.0",
    "@tiptap/extension-document": "^3.19.0",
    "@tiptap/extension-dropcursor": "^3.19.0",
    "@tiptap/extension-gapcursor": "^3.19.0",
    "@tiptap/extension-hard-break": "^3.19.0",
    "@tiptap/extension-list-item": "^3.19.0",
    "@tiptap/extension-paragraph": "^3.19.0",
    "@tiptap/extension-text": "^3.19.0",
    "@tiptap/extension-text-style": "^3.19.0",
    "@tiptap/pm": "^3.19.0",
    "@tiptap/react": "^3.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.555.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "reactjs-tiptap-editor": "^1.0.17",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "next": "16.2.2"
  },
  "license": "Apache-2.0"
}
