# =============================================================================
# cms0 self-host app env example
# Location owner: apps/admin
# Localhost-first env example for the self-host App Router rework.
# =============================================================================

# -----------------------------------------------------------------------------
# Core app / auth
# -----------------------------------------------------------------------------
PORT=3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-long-random-secret
CMS0_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CMS0_DOCS_BASE_URL=http://localhost:3008
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Parity carryover from the previous self-host env
# Preserved because they still describe intended production behavior even where
# the rework has not fully wired them yet.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ORG_NAME=Acme Inc.

DATABASE_URL=postgres://postgres:rrrr@localhost:5433/cms0_conceptual_rework
DRIZZLE_DIALECT=postgresql
CMS0_DB_PUSH_ATTEMPTS=3
CMS0_DB_PUSH_RETRY_DELAY_MS=200

CMS0_EMAIL_TRANSPORT=log
CMS0_EMAIL_FROM=no-reply@example.com
CMS0_EMAIL_FROM_NAME=cms0
CMS0_EMAIL_REPLY_TO=
CMS0_EMAIL_REPLY_TO_NAME=
CMS0_EMAIL_SMTP_HOST=
CMS0_EMAIL_SMTP_PORT=587
CMS0_EMAIL_SMTP_SECURE=false
CMS0_EMAIL_SMTP_USERNAME=
CMS0_EMAIL_SMTP_PASSWORD=
CMS0_EMAIL_PLUNK_SECRET_KEY=
CMS0_EMAIL_PLUNK_BASE_URL=
NEXT_PUBLIC_ENABLE_EMAIL=true

CMS0_STORAGE_PATH=./storage
CMS0_ASSET_BASE_URL=http://localhost:3000
# Default self-host runtime storage root. The shared admin runtime now supports
# pluggable storage drivers, so future self-host adapters such as S3-compatible
# object storage can sit behind the same runtime package.
CMS0_STORAGE_DRIVER=filesystem
CMS0_STORAGE_BUCKET=
CMS0_STORAGE_REGION=auto
CMS0_STORAGE_ENDPOINT=
CMS0_STORAGE_ACCESS_KEY_ID=
CMS0_STORAGE_SECRET_ACCESS_KEY=
CMS0_STORAGE_FORCE_PATH_STYLE=true
CMS0_STORAGE_PREFIX=
CMS0_BACKUPS_PATH=./storage/backups
CMS0_BACKUPS_RETENTION=3

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# E2E helpers
# -----------------------------------------------------------------------------
E2E_BASE_URL=http://localhost:4102
