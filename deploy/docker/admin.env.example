# Copy this file to deploy/docker/admin.env before running docker compose.
# Replace all secrets before using this stack outside local development.

CMS0_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ORG_NAME=cms0

CMS0_ASSET_BASE_URL=http://localhost:3000
NEXT_PUBLIC_CMS0_DOCS_BASE_URL=https://cms0.io/docs

CMS0_EMAIL_TRANSPORT=log
CMS0_EMAIL_FROM=no-reply@example.com
CMS0_EMAIL_FROM_NAME=cms0
CMS0_EMAIL_REPLY_TO=
CMS0_EMAIL_REPLY_TO_NAME=
CMS0_EMAIL_SMTP_HOST=
CMS0_EMAIL_SMTP_PORT=587
CMS0_EMAIL_SMTP_SECURE=false
CMS0_EMAIL_SMTP_USERNAME=
CMS0_EMAIL_SMTP_PASSWORD=
CMS0_EMAIL_PLUNK_SECRET_KEY=
CMS0_EMAIL_PLUNK_BASE_URL=
NEXT_PUBLIC_ENABLE_EMAIL=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CMS0_BACKUPS_RETENTION=3
CMS0_DB_PUSH_ATTEMPTS=5
CMS0_DB_PUSH_RETRY_DELAY_MS=500
