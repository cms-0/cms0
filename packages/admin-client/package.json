{
  "name": "@cms0/admin-client",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:clean && tsc -p tsconfig.json",
    "build:clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true });\"",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:unit": "pnpm -C ../.. exec vitest run --config vitest.config.ts --project admin-client-unit",
    "test": "pnpm test:unit"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@cms0/admin-contract": "workspace:*",
    "@cms0/shared": "workspace:*",
    "@tanstack/react-query": "^5.90.11"
  },
  "devDependencies": {
    "@types/node": "^24.10.1"
  },
  "license": "Apache-2.0"
}
